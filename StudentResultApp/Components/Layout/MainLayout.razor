@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        
        <article class="content px-4">
            @Body
        </article>
        <footer class="border-top footer text-muted mt-4 p-3">
            <div class="container">
                Student Result Management System © 2026 | Built with Blazor and Azure DevOps
            </div>
        </footer>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
