@page "/settings"

<PageTitle>Settings - SRMS</PageTitle>

<div class="settings-page">

    <div class="page-header">
        <div>
            <h1>Settings</h1>
            <p>Configure your Student Result Management System.</p>
        </div>
    </div>

    <div class="settings-grid">

        <div class="settings-card">

            <div class="settings-card-header">
                <div>
                    <h5>General Settings</h5>
                    <p>Configure the main application details.</p>
                </div>
            </div>

            <div class="settings-card-body">

                <div class="setting-group">
                    <label>Application Name</label>
                    <input class="form-control"
                           value="Student Result Management System" />
                </div>

                <div class="setting-group">
                    <label>Academic Year</label>
                    <input class="form-control"
                           value="2026" />
                </div>

            </div>

        </div>

        <div class="settings-card">

            <div class="settings-card-header">
                <div>
                    <h5>Academic Configuration</h5>
                    <p>Define how student results are calculated.</p>
                </div>
            </div>

            <div class="settings-card-body">

                <div class="setting-group">
                    <label>Pass Mark (%)</label>
                    <input class="form-control"
                           value="50" />
                </div>

                <div class="setting-group">
                    <label>Maximum Mark</label>
                    <input class="form-control"
                           value="100" />
                </div>

            </div>

        </div>

        <div class="settings-card">

            <div class="settings-card-header">
                <div>
                    <h5>Deployment</h5>
                    <p>View the current application environment.</p>
                </div>
            </div>

            <div class="settings-card-body">

                <div class="setting-row">
                    <span>Environment</span>
                    <strong>Production</strong>
                </div>

                <div class="setting-row">
                    <span>Platform</span>
                    <strong>Azure App Service</strong>
                </div>

                <div class="setting-row">
                    <span>CI/CD</span>
                    <span class="status-badge active">
                        ● GitHub Actions
                    </span>
                </div>

            </div>

        </div>

        <div class="settings-card">

            <div class="settings-card-header">
                <div>
                    <h5>System Information</h5>
                    <p>Application and release information.</p>
                </div>
            </div>

            <div class="settings-card-body">

                <div class="setting-row">
                    <span>Version</span>
                    <strong>1.0.0</strong>
                </div>

                <div class="setting-row">
                    <span>Framework</span>
                    <strong>Blazor</strong>
                </div>

                <div class="setting-row">
                    <span>Status</span>
                    <span class="status-badge active">
                        ● Healthy
                    </span>
                </div>

            </div>

        </div>

    </div>

    <div class="settings-actions">

        <button class="btn btn-light">
            Reset
        </button>

        <button class="btn btn-primary">
            Save Changes
        </button>

    </div>

</div>