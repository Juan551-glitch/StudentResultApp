@page "/"

<div class="container-fluid">

    <div class="p-5 mb-4 bg-light rounded-3 shadow-sm">
        <div class="container-fluid py-4">
            <h1 class="display-5 fw-bold">Student Result Management System</h1>

            <p class="col-md-10 fs-5">
                A modern academic management platform built with Blazor and Azure DevOps to streamline student result processing, reporting, and system collaboration.
            </p>

            <a class="btn btn-primary btn-lg" href="/student-results">
                Open Result Management
            </a>
        </div>
    </div>

    <div class="row g-4">

        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title">Students</h5>
                    <p class="display-6 fw-bold">14</p>
                    <p class="text-muted">Registered learners</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title">Modules</h5>
                    <p class="display-6 fw-bold">4</p>
                    <p class="text-muted">Active academic modules</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title">Pass Rate</h5>
                    <p class="display-6 fw-bold">86%</p>
                    <p class="text-muted">Current performance summary</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title">DevOps Status</h5>
                    <p class="display-6 fw-bold">Active</p>
                    <p class="text-muted">Azure Repos workflow enabled</p>
                </div>
            </div>
        </div>

    </div>

    <div class="row mt-5">

        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header fw-bold">
                    System Features
                </div>
                <div class="card-body">
                    <ul>
                        <li>Capture student marks</li>
                        <li>Calculate pass or fail results</li>
                        <li>View results in a structured table</li>
                        <li>Track development using Azure Boards and Git</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header fw-bold">
                    DevOps Workflow
                </div>
                <div class="card-body">
                    <p>
                        This application is developed using Azure DevOps Boards,
                        Azure Repos, Git feature branches, commits, pull requests,
                        and traceable work items.
                    </p>

                    <a class="btn btn-outline-primary" href="/student-results">
                        Open Result Management
                    </a>
                </div>
            </div>
        </div>

    </div>

</div>