@page "/student-results"
@rendermode InteractiveServer
@using StudentResultApp.Models
@using Microsoft.EntityFrameworkCore
@using StudentResultApp.Data
@inject AppDbContext DbContext

<div class="card shadow-sm mb-4">

    <div class="card-header bg-dark text-white">
        <h4 class="mb-0">Student Results Dashboard</h4>
    </div>

    <div class="card-body">

<div class="card p-4 shadow-sm">

    <div class="row mb-3">

        <div class="col-md-6">
            <label class="form-label">Student Number</label>

            <input class="form-control"
                   @bind="student.StudentNumber" />
        </div>

        <div class="col-md-6">
            <label class="form-label">Full Name</label>

            <input class="form-control"
                   @bind="student.FullName" />
        </div>

    </div>

    <div class="row mb-3">

        <div class="col-md-6">
            <label class="form-label">Module</label>

            <input class="form-control"
                   @bind="student.Module" />
        </div>

        <div class="col-md-6">
            <label class="form-label">Mark</label>

            <input type="number"
                   class="form-control"
                   @bind="student.Mark" />
        </div>

    </div>

    <button class="btn btn-primary"
            @onclick="AddStudent">
                Save Student Result
    </button>

    @* Shows a friendly message instead of crashing the page when saving fails. *@
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p class="text-danger mt-2">@errorMessage</p>
    }

</div>
</div>
</div>

<br />

<table class="table table-bordered table-striped">

    <thead class="table-dark">

        <tr>
            <th>Student No.</th>
            <th>Full Name</th>
            <th>Module</th>
            <th>Mark</th>
            <th>Result</th>
        </tr>

    </thead>

    <tbody>

        @if (students.Count == 0)
        {
            <tr>
                <td colspan="5" class="text-center text-muted">
                    No student results captured yet.
                </td>
            </tr>
        }
        else
        {
            @foreach (var item in students)
            {
                <tr>
                    <td>@item.StudentNumber</td>
                    <td>@item.FullName</td>
                    <td>@item.Module</td>
                    <td>@item.Mark</td>
                    <td>
                        @if (item.Mark >= 50)
                        {
                            <span class="badge bg-success">Pass</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Fail</span>
                        }
                    </td>
                </tr>
            }
        }

    </tbody>

</table>

@code {

    private Student student = new();

    private List<Student> students = new();

    // Holds a friendly message to show the user if saving fails.
    private string? errorMessage;

    // Runs when the page first loads. Loads the saved students from the
    // database instead of starting with an empty in-memory list.
    protected override async Task OnInitializedAsync()
    {
        students = await DbContext.Students.ToListAsync();
    }

    // Made async because saving now talks to the real database.
    private async Task AddStudent()
    {
        errorMessage = null; // clear any old error message before trying again

        // Add the new student straight to the database table.
        var newStudent = new Student
        {
            StudentNumber = student.StudentNumber,
            FullName = student.FullName,
            Module = student.Module,
            Mark = student.Mark
        };
        DbContext.Students.Add(newStudent);

        try
        {
            await DbContext.SaveChangesAsync(); // actually save it to the database
        }
        catch (DbUpdateException)
        {
            // This happens if the Module doesn't match an existing module's
            // Code, or the Student Number is already used. Instead of
            // crashing the page, show a message and stop here.
            DbContext.Entry(newStudent).State = EntityState.Detached;
            errorMessage = "Could not save. Check that the Module matches an existing module's code, and that the Student Number is not already used.";
            return;
        }

        // Reload the list from the database so the table shows the new row.
        students = await DbContext.Students.ToListAsync();

        student = new Student();
    }

}